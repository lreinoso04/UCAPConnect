{
  "expo": {
    "name": "UCAPConnect",
    "slug": "ucapconnect-mejoras",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "ucapconnect",
    "platforms": [
      "ios",
      "android"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071A3B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.uapa.ucapconnect.mejoras",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "edu.uapa.ucapconnect.mejoras",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071A3B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.ucapconnect",
          "enableGooglePay": true
        }
      ],
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "owner": "djelia102",
    "extra": {
      "eas": {
        "projectId": "42c3b848-ff65-44b6-976a-d35ee0afba0f"
      }
    }
  }
}
